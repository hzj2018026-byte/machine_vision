# 复制为 .env 后按本机情况修改
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=ore_kids

# 可选：直接指定 SQLAlchemy 连接串（留空则按上面的 MySQL 参数拼接）
# DATABASE_URL=sqlite:///./ore_recognition.db

SECRET_KEY=please-change-this-to-a-long-random-string

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 低于该置信度提示用户重拍（旧模型准确率有限，建议 0.5~0.6）
CONFIDENCE_THRESHOLD=0.6

# 可选：覆盖模型路径
# MODEL_PATH=D:/ideaproject/shenduxuexizongheshijian/models/ore_classification_model.pth

# 是否启用水平翻转 TTA（默认 true）
USE_TTA=true
